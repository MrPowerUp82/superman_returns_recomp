<Application x:Class="SupermanReturnsLauncher.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Bg" Color="#10141D"/><SolidColorBrush x:Key="Panel" Color="#171D28"/>
  <SolidColorBrush x:Key="Accent" Color="#E23030"/><SolidColorBrush x:Key="Text" Color="#F3F5F7"/><SolidColorBrush x:Key="Muted" Color="#A9B0BC"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="FontSize" Value="13"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Margin" Value="0,6,0,15"/><Setter Property="Height" Value="34"/><Setter Property="Foreground" Value="#162032"/><Setter Property="Background" Value="#F0F2F7"/><Setter Property="Padding" Value="8,4"/>
   <Setter Property="ItemTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" Foreground="#162032"/></DataTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="MinHeight" Value="34"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Padding" Value="8,5"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Background" Value="#202838"/><Setter Property="BorderBrush" Value="#39465B"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Margin" Value="0,8,0,8"/></Style>
  <Style TargetType="Button"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="14,8"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/></Style>
 </Application.Resources>
</Application>
