<Window x:Class="SupermanReturnsLauncher.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Superman Returns — Launcher" Width="1040" Height="780" MinWidth="860" MinHeight="620" WindowStartupLocation="CenterScreen"
 Background="{StaticResource Bg}">
 <Grid Margin="24">
  <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{StaticResource Panel}" CornerRadius="12" Padding="22">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
     <TextBlock Text="SUPERMAN" FontSize="29" FontWeight="ExtraBold"/>
     <TextBlock Text="RETURNS" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
     <TextBlock Text="RECOMPILED" FontSize="13" Margin="1,4,0,28" Foreground="{StaticResource Muted}"/>
     <TextBlock Text="{DynamicResource ReadyHeading}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
     <TextBlock Text="{DynamicResource Intro}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,10,0,24"/>
     <Button Content="{DynamicResource Play}" Height="52" FontSize="18" Click="Play_Click" AutomationProperties.Name="{DynamicResource PlayAccessible}"/>
     <Button Content="BENCHMARK" Margin="0,10,0,0" Background="#30394A" Click="Benchmark_Click" AutomationProperties.Name="Benchmark"/>
     <Button Content="{DynamicResource Save}" Margin="0,12,0,0" Background="#30394A" Click="Save_Click"/>
     <Button Content="{DynamicResource Defaults}" Margin="0,10,0,0" Background="Transparent" FontSize="11" Padding="4,10" Click="Defaults_Click"/>
     <TextBlock x:Name="StatusText" Text="{DynamicResource Ready}" Foreground="{StaticResource Muted}" Margin="0,18,0,0" TextWrapping="Wrap"/>
    </StackPanel>
    <StackPanel Grid.Row="2"><TextBlock Text="{DynamicResource EngineHeading}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
     <TextBlock Text="{DynamicResource EngineRecommendation}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,6,0,0" FontSize="12"/></StackPanel>
   </Grid>
  </Border>
  <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
   <StackPanel>
    <TextBlock Text="{DynamicResource Language}"/><ComboBox x:Name="LanguageBox" AutomationProperties.Name="{DynamicResource Language}" HorizontalAlignment="Left" MinWidth="190"/>
    <TextBlock Text="{DynamicResource SettingsHeading}" FontSize="27" FontWeight="SemiBold"/>
    <TextBlock x:Name="SummaryText" Foreground="{StaticResource Muted}" Margin="0,7,0,20"/>
    <CheckBox x:Name="CoopBox" Content="{DynamicResource Coop}" AutomationProperties.Name="{DynamicResource Coop}"/>
    <TextBlock x:Name="CoopNote" Text="{DynamicResource CoopNote}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12" Visibility="Collapsed"/>
    <UniformGrid Columns="2">
     <StackPanel Margin="0,0,12,0">
      <TextBlock Text="{DynamicResource Renderer}"/><ComboBox x:Name="RendererBox" AutomationProperties.Name="{DynamicResource Renderer}"/>
       <TextBlock Text="{DynamicResource GraphicsApi}"/><ComboBox x:Name="ApiBox" AutomationProperties.Name="{DynamicResource GraphicsApi}"/>
       <TextBlock Text="{DynamicResource WindowResolution}"/><ComboBox x:Name="ResolutionBox" AutomationProperties.Name="{DynamicResource ResolutionAccessible}"/>
      <TextBlock Text="{DynamicResource DisplayMode}"/><ComboBox x:Name="DisplayModeBox" AutomationProperties.Name="{DynamicResource DisplayMode}"/>
      <TextBlock Text="{DynamicResource Gpu}"/><ComboBox x:Name="GpuBox" AutomationProperties.Name="{DynamicResource Gpu}"/>
      <TextBlock Text="{DynamicResource Input}"/><ComboBox x:Name="InputBox" AutomationProperties.Name="{DynamicResource InputAccessible}"/>
     </StackPanel>
     <StackPanel Margin="12,0,0,0">
      <TextBlock Text="{DynamicResource RenderScale}"/><ComboBox x:Name="RenderScaleBox" AutomationProperties.Name="{DynamicResource RenderScale}"/>
      <TextBlock Text="{DynamicResource Antialiasing}"/><ComboBox x:Name="AaBox" AutomationProperties.Name="{DynamicResource AntialiasingAccessible}"/>
      <TextBlock Text="{DynamicResource TextureFilter}"/><ComboBox x:Name="FilterBox" AutomationProperties.Name="{DynamicResource TextureFilter}"/>
      <TextBlock Text="{DynamicResource FrameLimit}"/><ComboBox x:Name="FpsBox" AutomationProperties.Name="{DynamicResource FrameLimitAccessible}"/>
      <TextBlock Text="{DynamicResource Costume}"/><ComboBox x:Name="CostumeBox" AutomationProperties.Name="{DynamicResource Costume}"/>
      <TextBlock Text="{DynamicResource TextureMods}"/><ComboBox x:Name="TextureModsBox" AutomationProperties.Name="{DynamicResource TextureMods}" ToolTip="{DynamicResource TextureModsNote}"/>
     </StackPanel>
    </UniformGrid>
    <Expander Header="{DynamicResource TemporalGraphics}" Margin="0,0,0,12">
     <StackPanel Margin="0,10,0,0">
      <TextBlock Text="{DynamicResource GraphicsIntentNote}" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
      <UniformGrid Columns="2">
       <StackPanel Margin="0,0,12,0"><TextBlock Text="NVIDIA DLSS"/><ComboBox x:Name="DlssBox"/><TextBlock Text="{DynamicResource RtShadows}"/><ComboBox x:Name="RtShadowsBox"/><TextBlock Text="{DynamicResource RtShadowQuality}"/><ComboBox x:Name="RtQualityBox"/></StackPanel>
       <StackPanel Margin="12,0,0,0"><TextBlock Text="{DynamicResource CharacterShadows}"/><ComboBox x:Name="CharacterShadowsBox"/><TextBlock Text="{DynamicResource RtReflections}"/><ComboBox x:Name="ReflectionsBox"/></StackPanel>
      </UniformGrid>
     </StackPanel>
    </Expander>
    <TextBlock x:Name="FpsNote" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10"/>
    <CheckBox x:Name="FrameGenerationBox" Content="{DynamicResource FrameGeneration}" AutomationProperties.Name="{DynamicResource FrameGenerationAccessible}"/>
    <TextBlock Text="{DynamicResource FrameGenerationNote}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8"/>
    <StackPanel x:Name="FrameGenerationPanel" Margin="0,0,0,12">
     <TextBlock Text="{DynamicResource InstalledDll}" Foreground="{StaticResource Muted}"/>
     <DockPanel Margin="0,6,0,0"><Button DockPanel.Dock="Right" Content="{DynamicResource Browse}" Margin="8,0,0,0" Background="#30394A" Click="BrowseFrameGeneration_Click"/><TextBox x:Name="FrameGenerationDllBox" AutomationProperties.Name="Lossless.dll"/></DockPanel>
    </StackPanel>
    <Expander Header="{DynamicResource MoreGraphics}" Foreground="{StaticResource Text}" Margin="0,0,0,16">
     <StackPanel Margin="0,10,0,0"><TextBlock x:Name="EngineNote" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10"/><UniformGrid Columns="2">
      <StackPanel Margin="0,0,12,0"><TextBlock Text="{DynamicResource ShadowResolution}"/><ComboBox x:Name="ShadowBox"/></StackPanel>
      <StackPanel Margin="12,0,0,0"><TextBlock Text="{DynamicResource ShadowMsaa}"/><ComboBox x:Name="MsaaBox"/></StackPanel>
     </UniformGrid><CheckBox x:Name="VSyncBox" Content="{DynamicResource VSync}"/>
       <CheckBox x:Name="SkipIntroBox" Content="{DynamicResource SkipIntro}"/>
      <TextBlock Text="{DynamicResource ShadowNote}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12"/>
     </StackPanel>
    </Expander>
    <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="16">
     <StackPanel><TextBlock Text="{DynamicResource GameFiles}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
      <TextBlock Text="{DynamicResource BuildExecutable}" Foreground="{StaticResource Muted}"/>
      <DockPanel Margin="0,6,0,12"><Button DockPanel.Dock="Right" Content="{DynamicResource Browse}" Margin="8,0,0,0" Background="#30394A" Click="Browse_Click"/><TextBox x:Name="GameExeBox" AutomationProperties.Name="{DynamicResource GameExecutableAccessible}"/></DockPanel>
      <TextBlock Text="{DynamicResource GameFolder}" Foreground="{StaticResource Muted}"/>
      <DockPanel Margin="0,6,0,0"><Button DockPanel.Dock="Right" Content="{DynamicResource Browse}" Margin="8,0,0,0" Background="#30394A" Click="BrowseData_Click"/><TextBox x:Name="GameDataBox" AutomationProperties.Name="{DynamicResource GameFolderAccessible}"/></DockPanel>
     </StackPanel>
    </Border>
    <Expander Header="{DynamicResource LaunchDetails}" Foreground="{StaticResource Muted}" Margin="0,16,0,0"><TextBox x:Name="ArgumentsPreview" IsReadOnly="True" TextWrapping="Wrap" MinHeight="72" Margin="0,10,0,0"/></Expander>
   </StackPanel>
  </ScrollViewer>
 </Grid>
</Window>
