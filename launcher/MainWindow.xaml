<Window x:Class="SupermanReturnsLauncher.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Superman Returns — Launcher" Width="1040" Height="780" MinWidth="860" MinHeight="620" WindowStartupLocation="CenterScreen"
 Background="{StaticResource Bg}">
 <Grid Margin="24">
  <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{StaticResource Panel}" CornerRadius="12" Padding="22">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
     <TextBlock Text="SUPERMAN" FontSize="29" FontWeight="ExtraBold"/>
     <TextBlock Text="RETURNS" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
     <TextBlock Text="RECOMPILED" FontSize="13" Margin="1,4,0,28" Foreground="{StaticResource Muted}"/>
     <TextBlock Text="Pronto para Metropolis" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
     <TextBlock Text="Ajuste o jogo antes de começar. Suas preferências ficam salvas neste computador." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,10,0,24"/>
     <Button Content="JOGAR" Height="52" FontSize="18" Click="Play_Click" AutomationProperties.Name="Jogar"/>
     <Button Content="Salvar preferências" Margin="0,12,0,0" Background="#30394A" Click="Save_Click"/>
     <Button Content="Restaurar qualidade original" Margin="0,10,0,0" Background="Transparent" FontSize="11" Padding="4,10" Click="Defaults_Click"/>
     <TextBlock x:Name="StatusText" Text="Pronto." Foreground="{StaticResource Muted}" Margin="0,18,0,0" TextWrapping="Wrap"/>
    </StackPanel>
    <StackPanel Grid.Row="2"><TextBlock Text="MOTOR E API" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
     <TextBlock Text="Nativo + Direct3D 12 é a combinação validada." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,6,0,0" FontSize="12"/></StackPanel>
   </Grid>
  </Border>
  <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
   <StackPanel>
    <TextBlock Text="Configure sua experiência" FontSize="27" FontWeight="SemiBold"/>
    <TextBlock x:Name="SummaryText" Foreground="{StaticResource Muted}" Margin="0,7,0,20"/>
    <UniformGrid Columns="2">
     <StackPanel Margin="0,0,12,0">
      <TextBlock Text="Motor de renderização"/><ComboBox x:Name="RendererBox" AutomationProperties.Name="Motor de renderização"/>
       <TextBlock Text="API gráfica"/><ComboBox x:Name="ApiBox" AutomationProperties.Name="API gráfica"/>
       <TextBlock Text="Resolução da janela"/><ComboBox x:Name="ResolutionBox" AutomationProperties.Name="Resolução"/>
      <TextBlock Text="Modo de exibição"/><ComboBox x:Name="DisplayModeBox" AutomationProperties.Name="Modo de exibição"/>
      <TextBlock Text="Placa de vídeo"/><ComboBox x:Name="GpuBox" AutomationProperties.Name="Placa de vídeo"/>
      <TextBlock Text="Como você vai jogar"/><ComboBox x:Name="InputBox" AutomationProperties.Name="Controles"/>
     </StackPanel>
     <StackPanel Margin="12,0,0,0">
      <TextBlock Text="Resolução interna"/><ComboBox x:Name="RenderScaleBox" AutomationProperties.Name="Resolução interna"/>
      <TextBlock Text="Suavização da imagem"/><ComboBox x:Name="AaBox" AutomationProperties.Name="Suavização"/>
      <TextBlock Text="Filtro de texturas"/><ComboBox x:Name="FilterBox" AutomationProperties.Name="Filtro de texturas"/>
      <TextBlock Text="Limite de quadros"/><ComboBox x:Name="FpsBox" AutomationProperties.Name="Limite de FPS"/>
     </StackPanel>
    </UniformGrid>
    <TextBlock x:Name="FpsNote" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10"/>
    <Expander Header="Mais opções gráficas" Foreground="{StaticResource Text}" Margin="0,0,0,16">
     <StackPanel Margin="0,10,0,0"><TextBlock x:Name="EngineNote" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10"/><UniformGrid Columns="2">
      <StackPanel Margin="0,0,12,0"><TextBlock Text="Resolução das sombras"/><ComboBox x:Name="ShadowBox"/></StackPanel>
      <StackPanel Margin="12,0,0,0"><TextBlock Text="MSAA das sombras"/><ComboBox x:Name="MsaaBox"/></StackPanel>
     </UniformGrid><CheckBox x:Name="VSyncBox" Content="Sincronização vertical (VSync)"/>
       <CheckBox x:Name="SkipIntroBox" Content="Pular logos e vídeos legais da abertura"/>
      <TextBlock Text="Sombras maiores e MSAA podem aumentar bastante o custo de renderização." Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12"/>
     </StackPanel>
    </Expander>
    <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="16">
     <StackPanel><TextBlock Text="Arquivos do jogo" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
      <TextBlock Text="Executável da build" Foreground="{StaticResource Muted}"/>
      <DockPanel Margin="0,6,0,12"><Button DockPanel.Dock="Right" Content="Procurar" Margin="8,0,0,0" Background="#30394A" Click="Browse_Click"/><TextBox x:Name="GameExeBox" AutomationProperties.Name="Executável do jogo"/></DockPanel>
      <TextBlock Text="Pasta game — default.xex e DATA" Foreground="{StaticResource Muted}"/>
      <DockPanel Margin="0,6,0,0"><Button DockPanel.Dock="Right" Content="Procurar" Margin="8,0,0,0" Background="#30394A" Click="BrowseData_Click"/><TextBox x:Name="GameDataBox" AutomationProperties.Name="Pasta do jogo"/></DockPanel>
     </StackPanel>
    </Border>
    <Expander Header="Detalhes de inicialização" Foreground="{StaticResource Muted}" Margin="0,16,0,0"><TextBox x:Name="ArgumentsPreview" IsReadOnly="True" TextWrapping="Wrap" MinHeight="72" Margin="0,10,0,0"/></Expander>
   </StackPanel>
  </ScrollViewer>
 </Grid>
</Window>
