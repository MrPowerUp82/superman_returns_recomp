+    out_caps->gamepad.thumb_rx = static_cast<int16_t>(0x7FFF);
+    out_caps->gamepad.thumb_ry = static_cast<int16_t>(0x7FFF);
+    out_caps->vibration.left_motor_speed = 0xFFFF;
