--- /dev/null
+++ b/include/rex/ui/presentation_pacing.h
@@ -0,0 +1,132 @@
+#pragma once
+#include <algorithm>
+#include <array>
+#include <chrono>
+#include <charconv>
+#include <cstdint>
+#include <cstdlib>
+#include <fstream>
+#include <memory>
+#include <ostream>
+#include <string_view>
+#include <thread>
