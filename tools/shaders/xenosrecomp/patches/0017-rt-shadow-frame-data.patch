+#ifdef CONAN_RECOMP
+    if (!isPixelShader && out.find("shadowMapU") != std::string::npos)
+    {
+        static const std::regex lightRow(R"(^(\s*)([A-Za-z0-9_]+\.[xyzw]) = dot\([^;]*\bshadowMap([UVZ])\b)");
+        std::string rebuilt;
+        rebuilt.reserve(out.size() + 1024);
+        size_t start = 0;
+        while (start < out.size())
