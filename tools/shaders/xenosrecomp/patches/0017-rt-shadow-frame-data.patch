@@ -236,6 +236,24 @@ TextureCube<float4> g_TextureCubeDescriptorHeap[] : register(t0, space2);
 Texture2DArray<float4> g_Texture2DArrayDescriptorHeap[] : register(t0, space6);
 #endif
 #define TEX_STACKED_BIT 0x10000000u
+// Ray-traced sun shadows (docs/cienie-rt-projekt.md): per-frame data in a raw
+// buffer at a fixed descriptor (the host reserves the last heap entries).
+// Bytes 0-47: rows of the inverse cascade-0 light matrix (light-space shadow
+// coordinate iTexCoord7 -> world); 64: debug mode; 68: valid.
+#if !defined(SR_VULKAN_BUFFERS) && !defined(__spirv__)
+ByteAddressBuffer g_RtBuffers[] : register(t0, space9);
+#define SR_RT_FRAME_INDEX 32766
+uint srRtDebug() { return g_RtBuffers[SR_RT_FRAME_INDEX].Load(68) != 0 ? g_RtBuffers[SR_RT_FRAME_INDEX].Load(64) : 0; }
+float3 srRtWorldPos(float3 lightCoord)
+{
+    ByteAddressBuffer b = g_RtBuffers[SR_RT_FRAME_INDEX];
+    float4 p = float4(lightCoord, 1.0);
+    return float3(dot(asfloat(b.Load4(0)), p), dot(asfloat(b.Load4(16)), p), dot(asfloat(b.Load4(32)), p));
+}
+#else
+uint srRtDebug() { return 0; }
+float3 srRtWorldPos(float3 lightCoord) { return lightCoord; }
+#endif
 #ifdef SR_VULKAN_BUFFERS
 [[vk::binding(0,2)]] SamplerState g_SamplerDescriptorHeap[32];
 #else
