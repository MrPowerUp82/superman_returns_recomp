         hasShadowAtlas |= strcmp(name, "g_ShadowMapTextureAtlas") == 0;
+    // Superman Returns: the cascaded shadow receivers (constant
+    // shadowMapOffsetScales) skip the shadow test beyond a literal 750 units,
+    // the far edge of the game's cascades (30 * 5^2). The host widens the
