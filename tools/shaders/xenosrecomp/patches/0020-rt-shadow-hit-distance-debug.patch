diff --git a/XenosRecomp/shader_common.h b/XenosRecomp/shader_common.h
index 20573b027b685da4d8b85b0ba0e544c77b514426..49b9e6273d81fca3d6e11c07a10bc0abbcfb492e 100644
--- a/XenosRecomp/shader_common.h
+++ b/XenosRecomp/shader_common.h
@@ -273,13 +273,34 @@ float srRtVisibility(float3 worldPos)
     q.Proceed();
     return q.CommittedStatus() == COMMITTED_TRIANGLE_HIT ? 0.0 : 1.0;
 }
+// Debug: distance along the sun ray to the nearest occluder, -1 = none.
+float srRtHitDistance(float3 worldPos)
+{
+    ByteAddressBuffer b = g_RtBuffers[SR_RT_FRAME_INDEX];
+    if (b.Load(72) == 0)
+        return -1.0;
+    float3 sun = asfloat(b.Load3(48));
+    float bias = max(asfloat(b.Load(76)), 0.01);
+    RayDesc ray;
+    ray.Origin = worldPos + sun * bias;
+    ray.TMin = bias * 0.5;
+    ray.Direction = sun;
+    ray.TMax = 20000.0;
+    RayQuery<RAY_FLAG_SKIP_PROCEDURAL_PRIMITIVES> q;
+    q.TraceRayInline(g_RtTlas, RAY_FLAG_NONE, 0xFF, ray);
+    while (q.Proceed())
+        q.CommitNonOpaqueTriangleHit();
+    return q.CommittedStatus() == COMMITTED_TRIANGLE_HIT ? q.CommittedRayT() : -1.0;
+}
 #else
 float srRtVisibility(float3 worldPos) { return 1.0; }
+float srRtHitDistance(float3 worldPos) { return -1.0; }
 #endif
 #else
 uint srRtDebug() { return 0; }
 float3 srRtWorldPos(float3 lightCoord) { return lightCoord; }
 float srRtVisibility(float3 worldPos) { return 1.0; }
+float srRtHitDistance(float3 worldPos) { return -1.0; }
 #endif
 #ifdef SR_VULKAN_BUFFERS
 [[vk::binding(0,2)]] SamplerState g_SamplerDescriptorHeap[32];
