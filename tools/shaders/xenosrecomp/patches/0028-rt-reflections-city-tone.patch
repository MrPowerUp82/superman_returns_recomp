+// Light on a reflection hit with the city shaders' tone (frame bytes 112..143,
+// taken from their constants): the pink ramp colour blended in by its strength,
+// the warm shadow colour where the sun does not reach; 1.35 = the lit level the
+// hits had before. Without the tone: grey light, 0.45 in shadow, 1.35 in sun.
+float3 srRtHitLight(float sun)
+{
+#if !defined(SR_VULKAN_BUFFERS) && !defined(__spirv__)
+    ByteAddressBuffer b = g_RtBuffers[SR_RT_FRAME_INDEX];
+    if (asfloat(b.Load(140)) > 0.0)
+    {
+        float4 shadow = asfloat(b.Load4(112));
+        float3 ramp = asfloat(b.Load3(128));
+        return 1.35 * lerp(1.0, ramp, shadow.w) * lerp(shadow.rgb, 1.0, sun);
+    }
+#endif
+    return 0.45 + 0.9 * sun;
+}
+
 // A receiver's environment sample (env_map) replaced by what a ray from the
 // pixel along the cube direction hits; the sky cube stays where it misses.
