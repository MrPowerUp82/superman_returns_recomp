+// Ray-traced reflections (byte 92: on): the closest scene triangle along dir,
+// coloured by its draw's colour texture (InstanceID: SRV index | 0x8000 for
+// PWL gamma, 0xFFFFFF = none) at its smallest mip, i.e. the material's mean
+// colour, lit by the sun where the hit point sees it (one shadow ray).
+bool srRtReflections()
+{
+    ByteAddressBuffer b = g_RtBuffers[SR_RT_FRAME_INDEX];
+    return b.Load(68) != 0 && b.Load(72) != 0 && b.Load(92) != 0;
+}
+bool srRtReflectTrace(float3 origin, float3 dir, out float t, out uint id)
+{
+    t = 0.0;
+    id = 0xFFFFFFu;
+    RayDesc ray;
+    ray.Origin = origin;
+    ray.TMin = 0.5;
+    ray.Direction = dir;
+    ray.TMax = 4000.0;
+    RayQuery<RAY_FLAG_SKIP_PROCEDURAL_PRIMITIVES> q;
+    q.TraceRayInline(g_RtTlas, RAY_FLAG_NONE, 0xFF, ray);
+    while (q.Proceed()) {}
+    if (q.CommittedStatus() != COMMITTED_TRIANGLE_HIT)
+        return false;
+    t = q.CommittedRayT();
+    id = q.CommittedInstanceID();
+    return true;
+}
 #else
 float srRtVisibility(float3 worldPos) { return 1.0; }
 float srRtHitDistance(float3 worldPos) { return -1.0; }
 bool srRtShadowsReplace() { return false; }
 float srRtVisibilitySoft(float3 worldPos) { return 1.0; }
+bool srRtReflections() { return false; }
+bool srRtReflectTrace(float3 origin, float3 dir, out float t, out uint id) { t = 0.0; id = 0xFFFFFFu; return false; }
 #endif
 #else
 uint srRtDebug() { return 0; }
