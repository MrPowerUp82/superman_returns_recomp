 #endif
 static float g_srRtShadowVis = -1.0;  // this pixel's sun visibility, -1 = use the shadow map
+static float3 g_srRtPixelPos = 0.0;   // this pixel's world position (receivers)
 // The receivers turn a fetch into shadow as saturate((receiver - fetched) * K),
 // K = depthBias_FadeRange_FalloffStart_FalloffRate.y. With srRtFade making K
 // 0.001, fetched = -1000 * (1 - visibility) gives shadow = 1 - visibility
@@ -542,6 +574,28 @@ float4 tfetchCube(uint resourceDescriptorIndex, uint samplerDescriptorIndex, flo
     return conanGamma(resourceDescriptorIndex, g_TextureCubeDescriptorHeap[TEX_INDEX(resourceDescriptorIndex)].Sample(g_SamplerDescriptorHeap[samplerDescriptorIndex], cubeMapData.cubeMapDirections[texCoord.z]));
 }
 
+// A receiver's environment sample (env_map) replaced by what a ray from the
+// pixel along the cube direction hits; the sky cube stays where it misses.
+float4 srRtReflect(float4 env, float3 texCoord, inout CubeMapData cubeMapData)
+{
+    if (!srRtReflections())
+        return env;
+    float3 dir = normalize(cubeMapData.cubeMapDirections[texCoord.z]);
+    float3 origin = g_srRtPixelPos + dir * 0.3;
+    float t;
+    uint id;
+    if (!srRtReflectTrace(origin, dir, t, id))
+        return env;
+    float sun = srRtVisibility(origin + dir * t);
+    float3 albedo = float3(0.45, 0.43, 0.40);
+    if (id != 0xFFFFFFu)
+    {
+        float4 texel = g_Texture2DDescriptorHeap[id & 0x7FFFu].SampleLevel(g_SamplerDescriptorHeap[0], 0.5, 16.0);
+        albedo = conanGamma((id & 0x8000u) ? 0x80000000u : 0u, texel).rgb;
+    }
+    return float4(albedo * (0.45 + 0.9 * sun), env.a);
+}
