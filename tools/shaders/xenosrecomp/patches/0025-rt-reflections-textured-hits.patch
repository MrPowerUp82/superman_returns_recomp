+// Material of a reflection hit (entry m of SR_RT_MATERIAL_INDEX) and its UV:
+// the captured interpolant of the triangle's corners, interpolated, times the
+// draw's UV scale plus offset. hasUv = false: no texture coordinates (the
+// texture's mean colour is used), m.y = 0xFFFFFF: no texture.
+void srRtHitMaterial(bool hit, uint id, uint prim, float2 bary, out uint4 m, out float2 uv, out bool hasUv)
+{
+    m = uint4(0xFFFFFFFFu, 0xFFFFFFu, 0, 0);
+    uv = 0.0;
+    hasUv = false;
+#if !defined(SR_VULKAN_BUFFERS) && !defined(__spirv__)
+    if (!hit)
+        return;
+    ByteAddressBuffer materials = g_RtBuffers[SR_RT_MATERIAL_INDEX];
+    m = materials.Load4(id * 32);
+    if (m.y == 0xFFFFFFu || m.x == 0xFFFFFFFFu || !srRtReflectionDetail())
+        return;
+    ByteAddressBuffer pool = g_RtBuffers[SR_RT_UV_INDEX];
+    uint b = (m.x + prim * 3) * 16;
+    float4 a = asfloat(pool.Load4(b)) * (1.0 - bary.x - bary.y) + asfloat(pool.Load4(b + 16)) * bary.x +
+               asfloat(pool.Load4(b + 32)) * bary.y;
+    float4 xf = asfloat(materials.Load4(id * 32 + 16));
+    uv = float2(a[m.z & 3u], a[(m.z >> 2) & 3u]) * xf.xy + xf.zw;
+    hasUv = true;
+#endif
+}
+
+// Colour of a reflection hit: the material's colour texture at uv with the
+// footprint of the neighbouring pixels' hits (dx, dy: their UV differences,
+// as the hardware takes them for an ordinary fetch); the smallest mip without
+// UV; stone grey without texture. Texture and sampler differ per pixel.
+float3 srRtHitAlbedo(uint4 m, float2 uv, bool hasUv, float2 dx, float2 dy)
+{
+#if defined(SR_VULKAN_BUFFERS) || defined(__spirv__)
+    return float3(0.45, 0.43, 0.40);
+#else
+    if (m.y == 0xFFFFFFu)
+        return float3(0.45, 0.43, 0.40);
+    Texture2D<float4> tex = g_Texture2DDescriptorHeap[NonUniformResourceIndex(m.y & 0x7FFFu)];
+    SamplerState samp = g_SamplerDescriptorHeap[NonUniformResourceIndex((m.z >> 8) & 0xFFFFu)];
+    float4 texel = hasUv ? tex.SampleGrad(samp, uv, dx, dy) : tex.SampleLevel(samp, 0.5, 16.0);
+    return conanGamma((m.y & 0x8000u) ? 0x80000000u : 0u, texel).rgb;
+#endif
+}
