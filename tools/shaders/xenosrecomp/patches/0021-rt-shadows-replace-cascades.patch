diff --git a/XenosRecomp/shader_common.h b/XenosRecomp/shader_common.h
index 49b9e6273d81fca3d6e11c07a10bc0abbcfb492e..29742cbb83fbf9cea5852cb7309d79cbb0a2b43c 100644
--- a/XenosRecomp/shader_common.h
+++ b/XenosRecomp/shader_common.h
@@ -292,16 +292,32 @@ float srRtHitDistance(float3 worldPos)
         q.CommitNonOpaqueTriangleHit();
     return q.CommittedStatus() == COMMITTED_TRIANGLE_HIT ? q.CommittedRayT() : -1.0;
 }
+// Ray-traced shadows replace the cascades (byte 80: on; not in the debug views):
+// the receivers' shadow map fetches return the light depth 1 (nothing in front)
+// where the sun is visible and 0 (occluded) where not, so the game's own
+// comparison, shadow density and colour turn the ray result into its shadow.
+bool srRtShadowsReplace()
+{
+    ByteAddressBuffer b = g_RtBuffers[SR_RT_FRAME_INDEX];
+    return b.Load(68) != 0 && b.Load(72) != 0 && b.Load(80) != 0;
+}
 #else
 float srRtVisibility(float3 worldPos) { return 1.0; }
 float srRtHitDistance(float3 worldPos) { return -1.0; }
+bool srRtShadowsReplace() { return false; }
 #endif
 #else
 uint srRtDebug() { return 0; }
 float3 srRtWorldPos(float3 lightCoord) { return lightCoord; }
 float srRtVisibility(float3 worldPos) { return 1.0; }
 float srRtHitDistance(float3 worldPos) { return -1.0; }
+bool srRtShadowsReplace() { return false; }
 #endif
+static float g_srRtShadowVis = -1.0;  // this pixel's sun visibility, -1 = use the shadow map
+float4 srRtShadowDepth(float4 fetched)
+{
+    return g_srRtShadowVis < 0.0 ? fetched : g_srRtShadowVis.xxxx;
+}
 #ifdef SR_VULKAN_BUFFERS
 [[vk::binding(0,2)]] SamplerState g_SamplerDescriptorHeap[32];
 #else
