     printDstSwizzle(instr.dstSwizzle, true);
 
@@ -1411,6 +1422,7 @@ void ShaderRecompiler::recompile(const uint8_t* shaderData, const std::string_vi
         srShadowReceiver |= strcmp(reinterpret_cast<const char*>(constantTableData + constantInfo->name),
                                    "shadowMapOffsetScales") == 0;
     }
+    srShadowReceiverShader = srShadowReceiver && isPixelShader;
 #endif
 
     out += "#ifdef __spirv__\n\n";
@@ -2108,6 +2120,11 @@ void ShaderRecompiler::recompile(const uint8_t* shaderData, const std::string_vi
     out += "\tfloat ps = 0.0;\n";
     if (isPixelShader)
     {
+#ifdef CONAN_RECOMP
+        // One sun ray per pixel; the shadow map fetches below read its result.
+        if (srShadowReceiverShader)
+            out += "\tg_srRtShadowVis = srRtShadowsReplace() ? srRtVisibility(srRtWorldPos(iSrLight.xyz)) : -1.0;\n";
