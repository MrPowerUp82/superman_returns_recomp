@@ -750,20 +751,21 @@ float3 srRtHitLight(float sun)
     return 0.45 + 0.9 * sun;
 }
 
-// A receiver's environment sample (env_map) replaced by what a ray from the
-// pixel along the cube direction hits; the sky cube stays where it misses.
-// Every pixel of the quad gets to the derivatives (misses with uv 0).
-float4 srRtReflect(float4 env, float3 texCoord, inout CubeMapData cubeMapData)
+// The reflection ray from this pixel along dir (offset: start distance; swapRB:
+// the colour in the B, G, R order the caller's swizzle undoes): the sky cube
+// sample stays where it misses. Every pixel of the quad gets to the
+// derivatives (misses with uv 0).
+float4 srRtReflectAlong(float4 env, float3 dir, float offset, bool swapRB)
 {
-    if (!srRtReflections() && srRtDebug() != 6 && srRtDebug() != 7)
-        return env;
-    float3 dir = normalize(cubeMapData.cubeMapDirections[texCoord.z]);
     g_srRtReflectSeen = env.rgb;
-    float3 origin = g_srRtPixelPos + dir * 0.3;
+    float3 origin = g_srRtPixelPos + dir * offset;
     float t;
     uint id, prim;
     float2 bary;
     bool hit = srRtReflectTrace(origin, dir, t, id, prim, bary);
+    // Debug 8: green = hit (red: its distance / 3000), blue = miss (red: dir.y).
+    if (srRtDebug() == 8)
+        g_srRtReflectSeen = hit ? float3(saturate(t / 3000.0), 1.0, 0.0) : float3(saturate(dir.y), 0.0, 1.0);
     uint4 m, m1;
     float2 uv;
     bool hasUv;
@@ -783,8 +785,38 @@ float4 srRtReflect(float4 env, float3 texCoord, inout CubeMapData cubeMapData)
     // (yellow: a character)
     float3 path = (m1.y & (1u << 11)) ? float3(1, 1, 0) : (m1.y & (1u << 9)) ? float3(1, 0, 0)
                 : m.y != 0xFFFFFFu ? float3(0, 1, 0) : float3(0, 0, 1);
-    g_srRtReflectSeen = srRtDebug() == 7 ? path * (hasUv ? 1.0 : 0.5) : color;
-    return float4(color, env.a);
+    if (srRtDebug() != 8)
+        g_srRtReflectSeen = srRtDebug() == 7 ? path * (hasUv ? 1.0 : 0.5) : color;
+    return float4(swapRB ? color.zyx : color, env.a);
+}
+// A receiver's environment sample (env_map) replaced by what a ray from the
+// pixel along the cube direction hits.
+float4 srRtReflect(float4 env, float3 texCoord, inout CubeMapData cubeMapData, bool swapRB)
+{
+    if (!srRtReflections() && srRtDebug() != 6 && srRtDebug() != 7)
+        return env;
+    return srRtReflectAlong(env, normalize(cubeMapData.cubeMapDirections[texCoord.z]), 0.3, swapRB);
+}
+// Water (pixel shaders with gWaterSpec): its sky sample becomes what a ray
+// along the reflection hits, then the game's own Fresnel and water colours mix
+// it as they mixed the sky. The game reads that cube with coordinates its
+// ripples move (the cube direction is a constant), so the ray is the view
+// direction from the camera (g_srRtCameraPos, from ViewInvMat) mirrored on the
+// water plane, tilted by the ripples through the sky sample's brightness.
+// Rays below the horizon are lifted to graze it: they would only find the
+// water itself.
+static float3 g_srRtCameraPos = 0.0;  // water: the camera's world position
+float4 srRtReflectWater(float4 env, float3 texCoord, inout CubeMapData cubeMapData, bool swapRB)
+{
+    if (!srRtReflections() && srRtDebug() != 6 && srRtDebug() != 7 && srRtDebug() != 8)
+        return env;
+    float3 view = normalize(g_srRtPixelPos - g_srRtCameraPos);
+    float3 dir = float3(view.x, -view.y, view.z);
+    float ripple = dot(env.rgb, 1.0 / 3.0) - 0.5;
+    dir.xz += ripple * 0.08;
+    dir = normalize(float3(dir.x, max(dir.y, 0.02), dir.z));
+    g_srRtReflectTMax = 16000.0;  // the skyline across the bay is past the receivers' 4000
+    return srRtReflectAlong(env, dir, 1.0, swapRB);
 }
 
