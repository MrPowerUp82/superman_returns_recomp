+#ifdef CONAN_RECOMP
+// Motion vectors for DLSS: the pixel's motion in NDC, previous minus current,
+// from the clip positions the vertex shader computed with the previous and the
+// current constants of its draw. 65000 in x marks "no history of this draw"
+// (g_SrMotionValid = 0: the host found no such draw the frame before, or the
+// pixel was behind the previous camera): the host's camera motion fills it.
+float4 srMotionNdcFor(float4 prev, float4 cur, uint valid)
+{
+    if (valid == 0)
+        return float4(65000.0, 0.0, 0.0, 0.0);
+    // 64000: a previous position behind the camera (also "use the camera").
+    if (prev.w <= 0.0 || cur.w <= 0.0)
+        return float4(64000.0, 0.0, 0.0, 0.0);
+    return float4(prev.xy / prev.w - cur.xy / cur.w, 0.0, 0.0);
+}
+#define srMotionNdc(PREV, CUR) srMotionNdcFor(PREV, CUR, g_SrMotionValid)
+#endif
