 }
+uint srRtSunRay(float3 worldPos, float3 dir, float bias)  // 1 = sun visible along dir
+{
+    RayDesc ray;
+    ray.Origin = worldPos + dir * bias;
+    ray.TMin = bias * 0.5;
+    ray.Direction = dir;
+    ray.TMax = 20000.0;
+    RayQuery<RAY_FLAG_ACCEPT_FIRST_HIT_AND_END_SEARCH | RAY_FLAG_SKIP_PROCEDURAL_PRIMITIVES> q;
+    q.TraceRayInline(g_RtTlas, RAY_FLAG_NONE, 0xFF, ray);
+    q.Proceed();
+    return q.CommittedStatus() == COMMITTED_TRIANGLE_HIT ? 0u : 1u;
+}
+// Penumbra: the fraction of the sun's disc visible from worldPos, from N rays
+// (byte 84) spread over a cone of tan(angular radius) (byte 88). Two rays at
+// opposite edges of the disc go first; when they agree the point is taken as
+// fully lit or fully shadowed and the rest is skipped, so only penumbra pixels
+// pay for all N. The pattern is rotated by a hash of the world position, so
+// the noise stays put on the surfaces when the camera moves.
+float srRtVisibilitySoft(float3 worldPos)
+{
+    ByteAddressBuffer b = g_RtBuffers[SR_RT_FRAME_INDEX];
+    uint rays = clamp(b.Load(84), 1u, 32u);
+    float spread = asfloat(b.Load(88));
+    if (rays == 1u || spread <= 0.0)
+        return srRtVisibility(worldPos);
+    float3 sun = asfloat(b.Load3(48));
+    float bias = max(asfloat(b.Load(76)), 0.01);
+    float3 t1 = normalize(cross(sun, abs(sun.y) < 0.9 ? float3(0, 1, 0) : float3(1, 0, 0)));
+    float3 t2 = cross(sun, t1);
+    float rot = frac(sin(dot(floor(worldPos * 16.0), float3(12.9898, 78.233, 37.719))) * 43758.5453) * 6.2831853;
+    float3 edge = (t1 * cos(rot) + t2 * sin(rot)) * spread;
+    uint lit = srRtSunRay(worldPos, normalize(sun + edge), bias) + srRtSunRay(worldPos, normalize(sun - edge), bias);
+    if (lit != 1u)
+        return lit == 2u ? 1.0 : 0.0;
+    for (uint i = 2; i < rays; ++i)
+    {
+        float r = spread * sqrt((float(i - 2) + 0.5) / float(rays - 2));
+        float a = rot + float(i) * 2.3999632;  // golden angle
+        lit += srRtSunRay(worldPos, normalize(sun + (t1 * cos(a) + t2 * sin(a)) * r), bias);
+    }
+    return float(lit) / float(max(rays, 2u));
+}
